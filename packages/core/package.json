    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "dom": [
        "./dist/dom/index.d.cts"
      ],
      "groups": [
        "./dist/groups/index.d.cts"
      ],
      "items": [
        "./dist/items/index.d.cts"
      ],
      "gantt": [
        "./dist/gantt/index.d.cts"
      ],
      "schedule": [
        "./dist/schedule/index.d.cts"
      ],
      "resources": [
        "./dist/resources/index.d.cts"
      ],
      "tools": [
        "./dist/tools/index.d.cts"
      ],
      "export": [
        "./dist/export/index.d.cts"
      ],
      "intl": [
        "./dist/intl/index.d.cts"
      ],
      "live": [
        "./dist/live/index.d.cts"
      ],
      "words": [
        "./dist/words/index.d.cts"
      ],
      "calendar": [
        "./dist/calendar/index.d.cts"
      ],
