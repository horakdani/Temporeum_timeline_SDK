        "default": "./dist/resources.cjs"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools/index.d.ts",
        "default": "./dist/tools.mjs"
      },
      "require": {
        "types": "./dist/tools/index.d.cts",
        "default": "./dist/tools.cjs"
      }
    },
