{
  "name": "@temporeum/timeline-core",
  "version": "1.0.0",
  "description": "An editable, responsive timeline engine: layout, ticks, collision-free lanes and rendering to an SVG scene, in Node or the browser. Zero runtime dependencies.",
  "license": "MIT",
  "author": "Daniel Horak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horakdani/Temporeum_timeline_SDK.git",
    "directory": "packages/core"
  },
  "homepage": "https://horakdani.github.io/Temporeum_timeline_SDK/",
  "bugs": {
    "url": "https://github.com/horakdani/Temporeum_timeline_SDK/issues"
  },
  "keywords": [
    "timeline",
    "gantt",
    "chronology",
    "svg",
    "editable",
    "accessible",
    "responsive",
    "zero-dependency"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
