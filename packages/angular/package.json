{
  "name": "@temporeum/timeline-angular",
  "version": "1.0.0",
  "description": "The Temporeum timeline as an Angular standalone component: editable, accessible, server-rendered and hydrated.",
  "license": "MIT",
  "author": "Daniel Horak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horakdani/Temporeum_timeline_SDK.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/horakdani/Temporeum_timeline_SDK#readme",
  "bugs": {
    "url": "https://github.com/horakdani/Temporeum_timeline_SDK/issues"
  },
  "keywords": [
    "timeline",
    "angular",
    "gantt",
    "editable",
    "accessible",
    "ssr"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@temporeum/timeline-element": "1.0.0"
  },
  "peerDependencies": {
    "@angular/common": ">=21.0.0",
    "@angular/core": ">=21.0.0",
    "rxjs": "^7.4.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && ngc -p tsconfig.build.json && rollup -c && node scripts/types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run --silent build -w @temporeum/timeline-core && npm run --silent build -w @temporeum/timeline-element && npm run --silent build && npm run --silent typecheck && vitest run --coverage"
  },
  "devDependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/platform-server": "~21.2.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "rxjs": "^7.8.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
