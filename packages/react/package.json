{
  "name": "@temporeum/timeline-react",
  "version": "1.0.0",
  "description": "The Temporeum timeline as a React component: editable, accessible, server-rendered and hydrated.",
  "license": "MIT",
  "author": "Daniel Horak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horakdani/Temporeum_timeline_SDK.git",
    "directory": "packages/react"
  },
  "homepage": "https://horakdani.github.io/Temporeum_timeline_SDK/",
  "bugs": {
    "url": "https://github.com/horakdani/Temporeum_timeline_SDK/issues"
  },
  "keywords": [
    "timeline",
    "react",
    "gantt",
    "editable",
    "accessible",
    "ssr"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@temporeum/timeline-element": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json --emitDeclarationOnly && rollup -c && node ../../scripts/sdk_cjs_types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run --silent build -w @temporeum/timeline-core && npm run --silent build -w @temporeum/timeline-element && npm run --silent build && npm run --silent typecheck && vitest run --coverage"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
