---
import { renderTimelineHtml } from "@temporeum/timeline-element";

const DAY = 86_400_000;
const t = Date.UTC(2026, 2, 2);
const items = [
  { id: "design", label: "Design", start: t, end: t + 7 * DAY },
  { id: "build", label: "Build", start: t + 5 * DAY, end: t + 19 * DAY },
  { id: "review", label: "Review", start: t + 21 * DAY },
  { id: "launch", label: "Launch", start: t + 25 * DAY, end: t + 32 * DAY },
];
const html = renderTimelineHtml({ items, height: 320, ariaLabel: "Release plan" }, { width: 960 });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Timeline — Astro</title>
  </head>
  <body style="margin: 0; font-family: system-ui, sans-serif">
    <main>
      <h1 style="font-size: 18px; padding: 0 16px">Release plan</h1>
      <Fragment set:html={html} />
    </main>
    <script>
      import "@temporeum/timeline-element/define";
    </script>
  </body>
</html>
