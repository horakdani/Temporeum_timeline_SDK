{
  "name": "@temporeum/timeline-svelte",
  "version": "1.0.0",
  "description": "The Temporeum timeline as a Svelte 5 component: editable, accessible, server-rendered and hydrated.",
  "license": "MIT",
  "author": "Daniel Horak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horakdani/Temporeum_timeline_SDK.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/horakdani/Temporeum_timeline_SDK#readme",
  "bugs": {
    "url": "https://github.com/horakdani/Temporeum_timeline_SDK/issues"
  },
  "keywords": [
    "timeline",
    "svelte",
    "sveltekit",
    "gantt",
    "editable",
    "accessible",
    "ssr"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@temporeum/timeline-element": "^1.0.0"
  },
  "peerDependencies": {
    "svelte": ">=5.20.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && svelte-package -i src -o dist && node -e \"const fs=require('node:fs');fs.copyFileSync('dist/Timeline.svelte.d.ts','dist/Timeline.d.svelte.ts')\"",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run --silent build -w @temporeum/timeline-core && npm run --silent build -w @temporeum/timeline-element && npm run --silent build && npm run --silent typecheck && vitest run --coverage"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
