{
  "name": "temporeum-timeline",
  "version": "0.0.0",
  "private": true,
  "description": "An editable, accessible, responsive timeline for the web — zero runtime dependencies.",
  "license": "MIT",
  "author": "Daniel Horak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horakdani/Temporeum_timeline_SDK.git"
  },
  "homepage": "https://horakdani.github.io/Temporeum_timeline_SDK/",
  "bugs": {
    "url": "https://github.com/horakdani/Temporeum_timeline_SDK/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/core",
    "packages/web-component",
    "packages/react",
    "packages/vue",
    "packages/svelte",
    "packages/angular",
    "packages/docs"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:all": "node scripts/sdk_test_all.mjs",
    "size": "npm run size -w @temporeum/timeline-core",
    "size:packages": "node scripts/sdk_size_packages.mjs",
    "lint": "eslint .",
    "deps": "node scripts/sdk_check_deps.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "publint": "0.3.25",
    "rolldown": "1.2.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
